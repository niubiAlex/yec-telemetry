# Postgres (Neon pooled URL on Vercel; added by the Neon integration).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Basic-auth password for the dashboard. Without it the dashboard is closed.
DASHBOARD_PASSWORD=
# Optional. When set, POST /api/events requires X-Ingest-Token to match
# (the pkg's YEC_TELEMETRY_TOKEN). It ships inside the installer, so it only
# filters drive-by noise; it is not a secret.
INGEST_TOKEN=
